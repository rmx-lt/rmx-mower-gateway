menu "rmx probe"

    comment "Passwords and the device name live in NVS (tools/provision_nvs.ps1)."

    config PROBE_DEVICE_NAME
        string "Default device name (used when NVS has none)"
        default "mower-01"
        help
            Used only when NVS has no creds/device key. The name is the MQTT
            username and client id (on 8883 the broker forces client id =
            username) and the <name> in mower/<name>/req|res|cmd|ack|status|fw.

    config PROBE_APN
        string "Cellular APN"
        default "internet"
        help
            APN of the SIM. "internet" for Tele2 LT / Pildyk.

    config PROBE_MQTT_URI
        string "MQTT broker URI"
        default "mqtts://mqtt.rmx.lt:8883"

    config PROBE_HEARTBEAT_S
        int "Seconds between MQTT create requests after the self-test (0 = off)"
        default 0
        range 0 86400

    config PROBE_OTA_CONFIRM_S
        int "Seconds a new image has to reach MQTT before it rolls back"
        default 300
        range 60 3600

    config PROBE_OTA_MIN_CSQ
        int "Minimum signal (AT+CSQ, 0-31) to start an update"
        default 5
        range 0 31

endmenu
